{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-loop/contract/record.schema.json",
  "title": "review-loop record (one per patch-id and round)",
  "description": "Stored at $(git rev-parse --git-common-dir)/review-loop/<patch-id>/round-<n>/record.json. Never committed. Holds no transcript content and no secret values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "key",
    "round",
    "created_at",
    "author_family",
    "reviewed_paths",
    "findings",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "enum": [
        "scan",
        "eot",
        "recheck",
        "epic",
        "ui",
        "gate",
        "sweep"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_id",
        "base_ref",
        "merge_base"
      ],
      "properties": {
        "patch_id": {
          "description": "git diff -U0 $(git merge-base <base> HEAD) HEAD | git patch-id --stable",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_ref": {
          "type": "string",
          "description": "Stored so the gate never guesses the base."
        },
        "merge_base": {
          "description": "EOE records are keyed by (patch_id, merge_base); EOT records set null.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Commit reviewed. recheck diffs from the last record's head."
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "description": "Branch checked out when reviewed: the ticket key that chains eot and recheck rounds."
    },
    "previous": {
      "description": "recheck: the record this round follows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_id",
        "round"
      ],
      "properties": {
        "patch_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "settled": {
      "description": "recheck: advisory model findings from earlier completed rounds; never reported again (by id). Fixed or discarded ones are re-verified if found again.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lens",
          "path",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lens": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "author_family": {
      "description": "From the model in use, never from the harness. unknown -> both families find and both must confirm.",
      "enum": [
        "claude",
        "gpt",
        "unknown"
      ]
    },
    "intent_source": {
      "enum": [
        "ticket",
        "intent",
        "commits",
        "prd"
      ]
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "family",
          "harness",
          "model"
        ],
        "properties": {
          "role": {
            "enum": [
              "finder",
              "verifier",
              "security-finder"
            ]
          },
          "family": {
            "enum": [
              "claude",
              "gpt",
              "other"
            ]
          },
          "harness": {
            "enum": [
              "claude",
              "codex",
              "copilot",
              "pi"
            ]
          },
          "model": {
            "type": "string"
          },
          "wall_seconds": {
            "type": "number",
            "minimum": 0
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string",
            "description": "A worker on trial (security-finder) that failed; its round still counts."
          }
        }
      }
    },
    "tools": {
      "description": "Scanner versions used; each checked against tools.lock.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reviewed_paths": {
      "description": "Self-reported coverage; must equal changed files minus the eligibility skip list, else outcome error.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "epic": {
      "description": "epic records only: what the epic review covered. Stored at <patch-id>/epic-<merge-base>/record.json.",
      "type": "object",
      "required": [
        "slug",
        "base",
        "tickets",
        "seams",
        "chunks",
        "checks",
        "follow_ups"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "commits",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "commits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "seams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "file",
                  "symbol"
                ]
              }
            }
          }
        },
        "chunks": {
          "description": "Cover `git diff --name-only <merge-base> <head>` exactly once; a file split into parts has `part: [k, n]`.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "paths",
              "lines",
              "review"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "lines": {
                "type": "integer",
                "minimum": 0
              },
              "review": {
                "type": "string"
              },
              "part": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_applicable",
                  "skipped",
                  "passed",
                  "failed",
                  "needs_human",
                  "informational"
                ]
              }
            }
          }
        },
        "follow_ups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "same_family_verify": {
          "description": "Findings no verifier of the other family could check.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicates": {
          "description": "Kept finding id -> ids from other chunks merged into it (same lens, overlapping first site).",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "summary"
      ],
      "properties": {
        "exit_code": {
          "description": "0 pass, 1 block, 2 needs_human, 3 tool error (block for D1/D2, needs_human for D3/D4).",
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "summary": {
          "description": "A clean run says no_findings_reported (unverified), never secure.",
          "enum": [
            "no_findings_reported (unverified)",
            "advisory_only",
            "blocked",
            "needs_human",
            "error"
          ]
        },
        "error": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "enum": [
                  "no_findings_reported (unverified)",
                  "advisory_only"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "const": "blocked"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "const": "needs_human"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "const": "error"
              }
            },
            "required": [
              "error"
            ]
          }
        }
      ]
    }
  }
}
