#!/usr/bin/env python3
"""review-loop CLI. usage: review-loop scan (--staged | --range A..B) [--sarif PATH]
       review-loop eot [--base REF] [--rev REV] [--ticket PATH | --intent TEXT] [--finder H[:M]]... [--verifier H[:M]]...
       review-loop recheck   (same flags as eot; only what changed since the last record, max 2 rechecks)
       review-loop label <finding-id> fixed|wrong|intentional|noise [--evidence TEXT]
       review-loop stats [--repo PATH]... [--csv PATH]
       review-loop sweep [--if-due] [--repo DIR] | --digest [ROOT]...   (whole-repo checks, report only)
       review-loop ui [--base REF] [--rev REV]   (UI lens: axe, keyboard, screenshots, base vs head)
       review-loop risk [--base REF] [--rev REV] [--format text|json|md]   (low / medium / high review effort)
       review-loop gate <remote> [<url>] [--block]   (pre-push ref lines on stdin)
       review-loop accept <finding-id> --reason TEXT [--expires YYYY-MM-DD] [--rule-class CLASS]   (needs a terminal)
       review-loop worker --harness claude|codex --role find|verify --model M --input FILE [--repo DIR] [--rev REV]"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

COMMANDS = ("scan", "eot", "recheck", "risk", "gate", "sweep", "ui", "label", "stats", "accept", "worker")

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.stderr.write(f"usage: review-loop {{{','.join(COMMANDS)}}} …\n")
        sys.exit(3)
    if sys.argv[1] == "worker":
        from review_loop import workers

        sys.exit(workers.main(sys.argv[2:]))
    if sys.argv[1] == "eot":
        from review_loop import eot

        sys.exit(eot.main(sys.argv[2:]))
    if sys.argv[1] == "recheck":
        from review_loop import recheck
        sys.exit(recheck.main(sys.argv[2:]))
    if sys.argv[1] == "ui":
        from review_loop import ui
        sys.exit(ui.main(sys.argv[2:]))
    if sys.argv[1] == "sweep":
        from review_loop import sweep
        sys.exit(sweep.main(sys.argv[2:]))
    if sys.argv[1] == "risk":
        from review_loop import risk
        sys.exit(risk.main(sys.argv[2:]))
    if sys.argv[1] == "gate":
        from review_loop import gate
        sys.exit(gate.main(sys.argv[2:]))
    if sys.argv[1] == "accept":
        from review_loop import accept
        sys.exit(accept.main(sys.argv[2:]))
    if sys.argv[1] in ("label", "stats"):
        from review_loop import stats
        sys.exit((stats.main_label if sys.argv[1] == "label" else stats.main_stats)(sys.argv[2:]))
    from review_loop import scan

    sys.exit(scan.main(sys.argv[2:]))
